# WonderKids API configuration
# Copy to .env and adjust as needed. NEVER commit the real .env (it is gitignored).

# HTTP port the API listens on.
PORT=3001

# ---------------------------------------------------------------------------
# PostgreSQL connection string.
# ---------------------------------------------------------------------------
# LOCAL (Docker): matches the repo-root docker-compose.yml. Host port 54329
# avoids clashing with a Postgres already running on 5432.
DATABASE_URL=postgres://wonderkids:wonderkids@localhost:54329/wonderkids

# PRODUCTION (Neon or other managed Postgres): use the pooled connection
# string and keep sslmode=require. Example shape (fill in real values):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# SSL is enabled automatically when the URL contains sslmode=require or points
# at a managed host (*.neon.tech, *.rds.amazonaws.com). Force it on anywhere
# with PGSSL=true. Only disable certificate verification if a provider needs it:
# PGSSL=true
# PGSSL_INSECURE=false

# Secret used to sign auth tokens. CHANGE THIS in any real deployment.
JWT_SECRET=dev-only-change-me

# How long an auth token stays valid.
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins (CORS).
# The Vite dev server runs on 4321 by default. In prod, set your site origin.
CORS_ORIGIN=http://localhost:4321
